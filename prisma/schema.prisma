// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  PHARMACIST
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
} 

model Pharmacy {
  id           String             @id @default(cuid())
  name         String
  address      String
  city         String
  phone        String
  email        String             @unique
  latitude     Float?
  longitude    Float?
  openingHours OpeningHour[]
  medicines    PharmacyMedicine[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model OpeningHour {
  id         String   @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  dayOfWeek  Int      // 0 = dimanche, 1 = lundi ... 6 = samedi
  opensAt    String   // "08:00"
  closesAt   String   // "19:00" (si closesAt <= opensAt, la plage passe minuit)

  @@unique([pharmacyId, dayOfWeek, opensAt])
  @@index([pharmacyId])
}

model PharmacyMedicine {
  pharmacyId String
  medicineId String

  price      Float
  quantity   Int

  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([pharmacyId, medicineId]) //Une même pharmacie ne peut avoir qu'une seule association avec un même médicament.
}

model Medicine {
  id          String   @id @default(cuid())
  name        String
  dosage     String?
  description String?
  pharmacy    PharmacyMedicine []
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
